{
  "uid": "zingybank-overview",
  "title": "ZingyBank — Service Overview",
  "tags": ["zingybank"],
  "timezone": "browser",
  "refresh": "15s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services Up",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "count(up{job=~\"zingybank.*\"} == 1)",
        "legendFormat": "UP"
      }],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "red", "value": 0 },
        { "color": "yellow", "value": 5 },
        { "color": "green", "value": 10 }
      ]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total HTTP Requests (5m)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(increase(http_server_requests_seconds_count{application=~\".*service|api-gateway\"}[5m]))",
        "legendFormat": "Requests"
      }],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(increase(http_server_requests_seconds_count{status=~\"5..\",application=~\".*service|api-gateway\"}[5m])) / sum(increase(http_server_requests_seconds_count{application=~\".*service|api-gateway\"}[5m])) * 100",
        "legendFormat": "Error %"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [
        { "color": "green", "value": 0 },
        { "color": "yellow", "value": 1 },
        { "color": "red", "value": 5 }
      ]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P99 Latency",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=~\".*service|api-gateway\"}[5m])) by (le))",
        "legendFormat": "P99"
      }],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [
        { "color": "green", "value": 0 },
        { "color": "yellow", "value": 1 },
        { "color": "red", "value": 3 }
      ]}}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active JVM Threads",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(jvm_threads_live_threads{application=~\".*service\"})",
        "legendFormat": "Threads"
      }],
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" }}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Request Rate by Service",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{application=~\".*service|api-gateway\"}[1m])) by (application)",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 }}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Error Rate by Service",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\",application=~\".*service|api-gateway\"}[1m])) by (application)",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM Heap Usage by Service",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "jvm_memory_used_bytes{area=\"heap\",application=~\".*service\"}",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 }}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request Latency P95 by Service",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=~\".*service|api-gateway\"}[5m])) by (le, application))",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 }}}
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Recent Frontend Errors",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "{service=\"zingybank-frontend\", level=\"error\"}",
        "legendFormat": ""
      }],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Service Logs (all)",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 8 },
      "datasource": { "uid": "loki" },
      "targets": [{
        "expr": "{job=\"zingybank\"}",
        "legendFormat": ""
      }],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": false }
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}
