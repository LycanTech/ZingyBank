# ZingyBank Local Development — Environment Variables
# Copy this file to .env and fill in your own values.
# The .env file is git-ignored and must NEVER be committed.
#
#   cp .env.example .env

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=zingybank
POSTGRES_PASSWORD=change_me_postgres

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis

# ── JWT ────────────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ characters). Generate with:
#   openssl rand -hex 32
JWT_SECRET=change_me_generate_a_256bit_random_string_here

# ── HashiCorp Vault (local dev mode only) ─────────────────────────────────────
VAULT_TOKEN=change_me_vault_dev_token

# ── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana
